rules_version = '2';

// 25WORLD Firestore 보안 규칙 (전체)
// 정적 호스팅(Netlify) + 클라이언트 Firebase 구조라, 앱이 쓰는 대부분의 컬렉션은
// 클라이언트에서 read/write 가 가능해야 한다.
// 단, 회원 명부(users)는 개인정보라 본인·관리자만 접근한다 (2026-09-16).
service cloud.firestore {
  match /databases/{database}/documents {

    // 블로그 글 본문 (posts/{id})
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 좋아요 (likes/{postId}_{uid})
    match /likes/{likeId} {
      allow read, write: if true;
    }

    // 즐겨찾기 (favorites/{postId}_{uid})
    match /favorites/{favId} {
      allow read, write: if true;
    }

    // 글 미리보기·카테고리 (previews/{postId})
    match /previews/{postId} {
      allow read, write: if true;
    }

    // 회원 프로필·등급 (users/{uid})
    // 2026-09-16 — 예전에는 "누구나 읽고 쓰기"라 공개 웹 API 키만으로 회원 전체의 이메일·등급이
    // 보였고, 회원이 자기 group 을 paid 로 바꾸는 자가 승격도 가능했다.
    //   · 읽기: 본인 문서만. 전체 목록은 관리자만
    //   · 본인 생성·수정: 이름·사진·테마 등은 자유, group·role·유튜브 무료횟수는 못 바꾼다
    //     (없던 group/role 에 기본값을 채우는 것만 허용 — 로그인 시 프로필 등록용)
    //   · 관리자: 주인장 구글 계정(이메일 인증됨), 또는 관리자가 group=admin 으로 지정한 계정
    //   · tg-post-saver 서버는 firebase-admin(서비스 계정)으로 접근해 이 규칙을 거치지 않는다
    match /users/{uid} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }
      function isAdmin() {
        return signedIn() && (
          (request.auth.token.email == 'herhero78@gmail.com'
            && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('group', '') == 'admin')
        );
      }
      // 본인이 바꿀 수 없는 필드를 건드리지 않았는가
      function ownerSafeUpdate(before, after) {
        let changed = after.diff(before).affectedKeys();
        return !changed.hasAny(['ytFreeUsed', 'ytLastFreeAt'])
          && (!changed.hasAny(['group']) || (!('group' in before) && after.group == 'general'))
          && (!changed.hasAny(['role']) || (!('role' in before) && after.role == 'user'));
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isOwner()
          && request.resource.data.get('group', 'general') == 'general'
          && request.resource.data.get('role', 'user') == 'user'
          && !request.resource.data.keys().hasAny(['ytFreeUsed', 'ytLastFreeAt'])
      );
      allow update: if isAdmin() || (isOwner() && ownerSafeUpdate(resource.data, request.resource.data));
      allow delete: if isAdmin();

      // 듀얼 브레인 질문·답변 기록 (users/{uid}/kbChats/{chatId}) — 2026-10-11
      //   · 본인만 읽고 지운다. 관리자도 남의 기록은 못 본다
      //   · 저장은 tg-post-saver 서버(firebase-admin)만 — 클라이언트 쓰기 금지
      match /kbChats/{chatId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 사이트 표시 설정·유료 지정 (siteMeta/config)
    match /siteMeta/{docId} {
      allow read, write: if true;
    }

    // 사이트별 부가 자료 — GIT 코드 주소·프롬프트(MD) 원문 (siteResources/{siteId})
    match /siteResources/{siteId} {
      allow read, write: if true;
    }

    // 음성(TTS) 메타·조각·큐
    match /audio/{key} {
      allow read, write: if true;
    }
    match /audio_parts/{partId} {
      allow read, write: if true;
    }
    match /ttsQueue/{jobId} {
      allow read, write: if true;
    }

    // tg-post-saver 맥북 ↔ Render 역할 분담 (2026-10-16)
    //   · runtime/mac: 맥북 하트비트 — Render 가 신선하면 음성 생성·자막 추출을 맥북에 양보한다
    //     (이 규칙이 없어 하트비트 쓰기가 늘 거부됐고, "맥북 우선" 분담이 실제로는 동작하지 않았다)
    //   · subJobs: 유튜브 자막 대행 큐 — Render(데이터센터 IP)는 자막 다운로드가 429 로 막혀
    //     맥북(가정용 IP)이 대신 받는다. 내용은 공개 영상 자막뿐이다
    //   둘 다 API 키(REST)로 접근해 ttsQueue 와 같이 개방형이다
    match /runtime/{docId} {
      allow read, write: if true;
    }
    match /subJobs/{jobId} {
      allow read, write: if true;
    }

    // 연구하기 (헤르메스 에이전트) — 2026-10-17
    //   · 등록: 주인장 구글 계정 또는 group=admin 만, 본인 uid·queued 상태로
    //   · 읽기·삭제: 본인 작업만 (질문·보고서는 비공개)
    //   · 진행 기록·보고서는 맥북 워커(firebase-admin)만 쓴다 — 클라이언트 수정 금지
    match /researchJobs/{jobId} {
      function isAdminUser() {
        return request.auth != null && (
          (request.auth.token.email == 'herhero78@gmail.com'
            && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('group', '') == 'admin')
        );
      }
      allow create: if isAdminUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'queued';
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 연구 슬라이드 PDF 조각 (researchFiles/{jobId}_pdf + __p0..N) — 본인만 읽기·삭제, 쓰기는 맥북 워커만
    match /researchFiles/{fileId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ★ 방문자 실시간 집계 (stats/visitors, stats/daily_{날짜})
    match /stats/{docId} {
      allow read, write: if true;
    }
  }
}
